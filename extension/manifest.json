{
  "manifest_version": 3,
  "name": "SafeSphere Guard",
  "version": "0.1.0",
  "description": "Watches live chatrooms for bullying, stalking and sextortion patterns with the SafeSphere engine, then alerts and guides you.",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "SafeSphere Guard", "default_icon": { "128": "icons/icon128.png" } },
  "icons": { "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["http://localhost/chatroom*", "http://127.0.0.1/chatroom*"],
      "js": ["lib/core.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["panel.css"], "matches": ["http://localhost/*", "http://127.0.0.1/*"] }
  ]
}
