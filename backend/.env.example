# Copy to backend/.env and fill in. Never commit the real .env.

# --- API key the UI must send as header  X-API-Key: <value>   (leave empty for local dev only)
SAFESPHERE_API_KEY=
# comma-separated origins allowed to call the API (the UI's dev server), * for anything in dev
SAFESPHERE_ALLOWED_ORIGINS=*

# --- behaviour model files (copied from the Colab run: models/behavior_model.pkl, models/text_models.pkl)
# SAFESPHERE_MODEL_DIR=./models
# SAFESPHERE_METRICS_PATH=./models/metrics.json
# SAFESPHERE_ML_DIR=../ml/behavior

# --- deepfake models: stub | http | python
DEEPFAKE_MODE=stub
# http mode: we POST multipart "file" (+ "context_text") to {DEEPFAKE_URL}/image|video|audio
DEEPFAKE_URL=
DEEPFAKE_API_KEY=
# python mode: importable function  f(kind: str, data: bytes, filename: str) -> dict
DEEPFAKE_PYTHON=
DEEPFAKE_TIMEOUT=60

# --- case conclusion (summary + applicable Acts) written by Gemini from the model's facts (never message text)
# leave empty to use the rule-based conclusion
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_THINKING_LEVEL=low
